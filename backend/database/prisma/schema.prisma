generator client {
  provider = "prisma-client-js"
  output   = "../../../frontend/node_modules/@prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   // 'Senior Pastor', 'Associate Pastor', 'Youth Pastor'
  posts     Post[]
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorTitle String
  thumbnail   String?
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}
