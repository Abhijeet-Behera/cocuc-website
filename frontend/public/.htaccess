<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS (Secure connection)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect WWW to non-WWW (Solves "WWW and non-WWW" critical issue)
  RewriteCond %{HTTP_HOST} ^www\.unionchurch\.in [NC]
  RewriteRule ^(.*)$ https://unionchurch.in/$1 [L,R=301]

  # 3. Redirect /index.html to the root / (Solves "Accessible index page" critical issue)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://unionchurch.in/ [R=301,L]

  # 4. Force Trailing Slash (Solves "Trailing slash" critical issue)
  # If the request is not for a direct file, and doesn't have a slash, add a slash.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]
</IfModule>
